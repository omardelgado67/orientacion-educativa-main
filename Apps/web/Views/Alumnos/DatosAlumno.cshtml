@{
    string numControl = "";
    if(ViewData[index: "NumControl"] != null)
    {
       numControl = ViewData[index: "NumControl"].ToString();
    }
}

@section Header{
    <link rel="stylesheet" href="~/css/credencial.css" asp-append-version="true" />
}

@section Scripts{
    <script src="~/js/datos-alumno.js"></script>
}

<h1>informacion del Alumno</h1>
<input type="hidden" value="@numControl" id="hidNumControl" />
<div class="container">
    <div class="row">
        <div class="col-sm-4">
            <!--Este es el codigo que me dio ChatGpt-->
           <div class="credencial">

        <!-- Encabezado -->
        <header class="encabezado">
            <div class="escudo">E</div>

            <div>
                <h2>Centro de Bachillerato Tecnológico Industrial y de Servicios No. 105</h2>
            </div>
        </header>

        <!-- Datos del alumno -->
        <main class="contenido">

            <div class="datos-principales">

                <!-- Coloca tu foto en la misma carpeta -->
                <img
                    class="foto"
                    src="~/imagenes/alumno.jpg"
                    alt="Fotografía del alumno"
                >

                <div class="informacion">
                    <p class="etiqueta">NOMBRE COMPLETO</p>
                    <p class="valor" data-bind="text:nombre">
                      
                    </p>

                    <hr class="separador">

                    <p class="etiqueta">NUMERO DE CONTROL</p>
                    <p class="valor" data-bind="text: numControl"></p>
                </div>

            </div>

            <hr class="separador">

            <!-- Carrera -->
            <div class="dato">
                <p class="etiqueta">CARRERA / ESPECIALIDAD</p>
                <p class="valor" data-bind="text: carrera"></p>
            </div>

            <!-- Semestre y grupo -->
            <div class="fila">

                <div class="cuadro">
                    <p class="etiqueta">SEMESTRE</p>
                    <p class="valor" data-bind="text: semestre"></p>
                </div>

                <div class="cuadro">
                    <p class="etiqueta">GRUPO</p>
                    <p class="valor" data-bind="text: grupo"></p>
                </div>

            </div>

            <!-- Generación -->
            <div class="generacion">

                <div>
                    <p class="etiqueta">GENERACIÓN</p>
                    <p class="valor" data-bind="text: generacion"></p>
                </div>

                <div class="icono-alumno">
                    &#9813;
                    <p>ALUMNO</p>
                </div>

            </div>

            <p class="aviso">Identificacion Escolar</p>

        </main>

        <!-- Pie de la credencial -->
        <footer class="pie">
           Cambiar fotografia
        </footer>

    </div>
            <!--fin chatgpt--> 
        </div>
       
        <div class="col-sm-8">

            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div>Pases de Salida</div>
                    <div>
                        <button class="btn btn-primary">Nuevo</button>
                    </div>
                </div>
                <div class="card-body">
                    <table class="table table-striped"> 
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Hora</th>
                                <th>Motivo</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td colspan="4">No hay registros para mostrar</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>